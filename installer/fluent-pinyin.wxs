<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="FluentPinyin"
    Manufacturer="FluentPinyin"
    Version="$(var.ProductVersion)"
    UpgradeCode="{9C0DE7C8-10B5-4C23-9DF7-2C23D6B8683D}"
    Scope="perMachine">
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of FluentPinyin is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Icon Id="AppIcon" SourceFile="assets\icons\fluent-pinyin.ico" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FluentPinyin">
        <Component Id="InstallRegistry" Guid="{D0762DC7-2C6B-4D92-BB79-6D0A4475359C}">
          <RegistryKey Root="HKLM" Key="Software\FluentPinyin">
            <RegistryValue Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
          </RegistryKey>
          <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="MainFeature" Title="FluentPinyin" Level="1">
      <ComponentRef Id="InstallRegistry" />
      <ComponentGroupRef Id="PayloadComponents" />
    </Feature>
    <CustomAction
      Id="InstallFonts"
      FileRef="DevtoolsExe"
      Execute="deferred"
      Impersonate="yes"
      ExeCommand='install-fonts "[INSTALLFOLDER]fonts"' />
    <CustomAction
      Id="RegisterTsf"
      Directory="INSTALLFOLDER"
      Execute="deferred"
      Impersonate="no"
      ExeCommand='[System64Folder]regsvr32.exe /s "[INSTALLFOLDER]fluent-pinyin-tsf.dll"' />
    <CustomAction
      Id="ActivateTsf"
      FileRef="DevtoolsExe"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore"
      ExeCommand='activate-session' />
    <CustomAction
      Id="ActivateFallbackInput"
      FileRef="DevtoolsExe"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore"
      ExeCommand='activate-ms-pinyin-session' />
    <CustomAction
      Id="CloseSettings"
      FileRef="DevtoolsExe"
      Execute="deferred"
      Impersonate="yes"
      ExeCommand='close-settings' />
    <CustomAction
      Id="ShutdownInputCore"
      FileRef="DevtoolsExe"
      Execute="deferred"
      Impersonate="yes"
      ExeCommand='shutdown-core' />
    <CustomAction
      Id="CleanupInstall"
      FileRef="DevtoolsExe"
      Execute="deferred"
      Impersonate="yes"
      ExeCommand='cleanup-install --skip-install-dir' />
    <CustomAction
      Id="UnregisterTsf"
      Directory="INSTALLFOLDER"
      Execute="deferred"
      Impersonate="no"
      ExeCommand='[System64Folder]regsvr32.exe /u /s "[INSTALLFOLDER]fluent-pinyin-tsf.dll"' />
    <InstallExecuteSequence>
      <Custom Action="CloseSettings" Before="ActivateFallbackInput" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="ActivateFallbackInput" Before="ShutdownInputCore" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="ShutdownInputCore" Before="UnregisterTsf" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="UnregisterTsf" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="CleanupInstall" After="UnregisterTsf" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="InstallFonts" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RegisterTsf" After="InstallFonts" Condition="NOT REMOVE" />
      <Custom Action="ActivateTsf" After="RegisterTsf" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
